{
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": "Configuration/Shared.xcconfig" },
    { "name": "Release", "file": "Configuration/Shared.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "App",
      "children": [
        {
          "kind": "folder",
          "path": "Sources",
          "target-membership": [
            "widgets",
          ],
          "membership-exceptions": [
            {
              "target": "widgets",
              "exclusions": [
                "Configuration/Info.plist",
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "Tests",
          "children": [
            { "kind": "folder", "path": "Application", "target-membership": [ "widgetsTests" ] },
            { "kind": "folder", "path": "Appearance", "target-membership": [ "widgetsTests" ] },
            { "kind": "folder", "path": "Features", "target-membership": [ "widgetsTests" ] },
            { "kind": "folder", "path": "Integration", "target-membership": [ "widgetsTests" ] },
            { "kind": "folder", "path": "TestSupport", "target-membership": [ "widgetsTests" ] },
            { "kind": "folder", "path": "UI", "target-membership": [ "widgetsUITests" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Frameworks",
      "children": [
        {
          "kind": "group",
          "path": "Encoding",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Encoding" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "EncodingTests" ] },
            { "path": "README.md" },
          ],
        }, {
          "kind": "group",
          "path": "Portfolio",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Portfolio" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "PortfolioTests" ] },
            { "path": "README.md" },
          ],
        }, {
          "kind": "group",
          "path": "RPC",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "RPC" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "RPCTests" ] },
            { "path": "README.md" },
          ],
        },
        { "kind": "folder", "path": "TestSupport", "target-membership": [ "PortfolioTests", "RPCTests" ] },
        {
          "kind": "group",
          "path": "Themes",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Themes" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "ThemesTests" ] },
            { "path": "README.md" },
          ],
        }, {
          "kind": "group",
          "path": "Transactions",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Transactions" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "TransactionsTests" ] },
            { "path": "README.md" },
          ],
        }, {
          "kind": "group",
          "path": "Vault",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Vault" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "VaultTests" ] },
            { "path": "README.md" },
          ],
        }, {
          "kind": "group",
          "path": "Wallet",
          "children": [
            { "kind": "folder", "path": "Sources", "target-membership": [ "Wallet" ] },
            { "kind": "folder", "path": "Tests", "target-membership": [ "WalletTests" ] },
            { "path": "README.md" },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Configuration",
      "children": [
        { "path": "Shared.xcconfig" },
        { "path": "App.xcconfig" },
        { "path": "Local.example.xcconfig" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/widgets.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        {
          "path": "<PRODUCTS>/RPC.framework",
          "id": "A10000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "Portfolio/frameworks",
            "RPCTests/frameworks",
            "PortfolioTests/frameworks",
            "widgetsTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Portfolio.framework",
          "id": "A20000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "PortfolioTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Wallet.framework",
          "id": "A30000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "Vault/frameworks",
            "widgetsTests/frameworks",
            "WalletTests/frameworks",
            "VaultTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Transactions.framework",
          "id": "A50000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "widgetsTests/frameworks",
            "TransactionsTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Encoding.framework",
          "id": "A60000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "Wallet/frameworks",
            "Transactions/frameworks",
            "EncodingTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Themes.framework",
          "id": "A90000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "ThemesTests/frameworks",
          ],
        }, {
          "path": "<PRODUCTS>/Vault.framework",
          "id": "A40000000000000000000001",
          "type": "wrapper.framework",
          "target-membership": [
            "widgets/frameworks",
            { "build-phase": "widgets/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "widgetsTests/frameworks",
            "VaultTests/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/RPCTests.xctest", "id": "A10000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/PortfolioTests.xctest", "id": "A20000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/widgetsTests.xctest", "id": "A70000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/widgetsUITests.xctest", "id": "AA0000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/WalletTests.xctest", "id": "A30000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/TransactionsTests.xctest", "id": "A50000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/EncodingTests.xctest", "id": "A60000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/ThemesTests.xctest", "id": "A90000000000000000000002", "type": "wrapper.cfbundle" },
        { "path": "<PRODUCTS>/VaultTests.xctest", "id": "A40000000000000000000002", "type": "wrapper.cfbundle" },
      ],
    },
  ],
  "targets": [
    {
      "name": "widgets",
      "id": "000000000000000100000000",
      "product": "Products/widgets.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Configuration/App.xcconfig" },
        { "name": "Release", "file": "Configuration/App.xcconfig" },
      ],
      "dependencies": [
        "Encoding",
        "Themes",
        "RPC",
        "Portfolio",
        "Wallet",
        "Transactions",
        "Vault",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "App/Sources/Configuration/widgets.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "R64MTWS872",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "App/Sources/Configuration/Info.plist",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "Use Face ID to access your wallet recovery material.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.raulriera.widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "27.1",
      },
    }, {
      "name": "RPC",
      "id": "A10000000000000000000014",
      "product": "Products/RPC.framework",
      "product-type": "framework",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "DEFINES_MODULE": "YES",
        "DEVELOPMENT_TEAM": "SC677X4LH6",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
