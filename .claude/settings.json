{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-xcsift.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(jq -r .cwd)\" || exit 0; changes=$(git status --short | head -30); [ -z \"$changes\" ] || printf 'Branch: %s\\nUncommitted changes:\\n%s\\n' \"$(git branch --show-current)\" \"$changes\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-swift.sh",
            "timeout": 30,
            "statusMessage": "Linting Swift"
          }
        ]
      }
    ]
  }
}
